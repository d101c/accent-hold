#: accentPicker.js:99
msgid "Type a letter…"
msgstr "Tapez une lettre…"

#: panelIndicator.js:17 prefs.js:54
msgid "Accent Hold"
msgstr "Accent Hold"

#: panelIndicator.js:28 prefs.js:93 prefs.js:131
msgid "Enabled"
msgstr "Activé"

#: panelIndicator.js:37
msgid "Preferences"
msgstr "Préférences"

#: panelIndicator.js:42
msgid "Hide this icon"
msgstr "Masquer cette icône"

#: prefs.js:28
msgid "French (fr)"
msgstr "Français (fr)"

#: prefs.js:29
msgid "French (oss variant)"
msgstr "Français (variante oss)"

#: prefs.js:30
msgid "English US (us)"
msgstr "Anglais US (us)"

#: prefs.js:31
msgid "English US International"
msgstr "Anglais US international"

#: prefs.js:32
msgid "English GB (gb)"
msgstr "Anglais GB (gb)"

#: prefs.js:33
msgid "German (de)"
msgstr "Allemand (de)"

#: prefs.js:34
msgid "Spanish (es)"
msgstr "Espagnol (es)"

#: prefs.js:35
msgid "Italian (it)"
msgstr "Italien (it)"

#: prefs.js:36
msgid "Portuguese (pt)"
msgstr "Portugais (pt)"

#: prefs.js:37
msgid "Belgian (be)"
msgstr "Belge (be)"

#: prefs.js:38
msgid "Swiss (ch)"
msgstr "Suisse (ch)"

#: prefs.js:39
msgid "Canadian (ca)"
msgstr "Canadien (ca)"

#: prefs.js:71
msgid "More from the Hold family"
msgstr "Aussi dans la famille Hold"

#: prefs.js:72
msgid ""
"Same gesture, same look. It installs its engine from its own settings, "
"without a terminal."
msgstr ""
"Même geste, même apparence. Elle installe son moteur depuis ses propres "
"réglages, sans terminal."

#: prefs.js:76
msgid "Voice Hold"
msgstr "Voice Hold"

#: prefs.js:76
msgid "Hold a key and dictate, offline."
msgstr "Maintenez une touche et dictez, hors-ligne."

#: prefs.js:87
msgid "Press and hold"
msgstr "Appui long"

#: prefs.js:88
msgid ""
"Hold a letter to choose its accent: press its number, or move with the "
"arrows and press Enter, or click. Space keeps the plain letter."
msgstr ""
"Maintenez une lettre pour choisir son accent : tapez son numéro, ou déplacez-"
"vous avec les flèches puis Entrée, ou cliquez. Espace garde la lettre simple."

#: prefs.js:94
msgid "Works in applications that support the GNOME input method."
msgstr ""
"Fonctionne dans les applications compatibles avec la méthode de saisie de "
"GNOME."

#: prefs.js:101
msgid "Hold duration"
msgstr "Durée d’appui"

#: prefs.js:102
msgid "Milliseconds a letter must be held."
msgstr "Millisecondes pendant lesquelles maintenir la lettre."

#: prefs.js:115
msgid "Pick on release"
msgstr "Choisir au relâchement"

#: prefs.js:116
msgid "Releasing the letter picks the highlighted variant."
msgstr "Relâcher la lettre choisit la variante surlignée."

#: prefs.js:125
msgid "Shortcut"
msgstr "Raccourci"

#: prefs.js:126
msgid "Key that triggers the accent picker."
msgstr "Touche déclenchant le sélecteur d’accents."

#: prefs.js:132
msgid "Enable or disable the shortcut."
msgstr "Active ou inhibe le raccourci."

#: prefs.js:139
msgid "Click the button, then press the combination."
msgstr "Cliquez sur le bouton puis appuyez sur la combinaison."

#: prefs.js:141
msgid "Combination"
msgstr "Combinaison"

#: prefs.js:151
msgid "Use a modifier (Ctrl, Alt, Super…) or a function key."
msgstr ""
"Utilisez un modificateur (Ctrl, Alt, Super…) ou une touche de fonction."

#: prefs.js:160
msgid "Disabled"
msgstr "Désactivé"

#: prefs.js:182
msgid "Press a key…"
msgstr "Appuyez sur une touche…"

#: prefs.js:227
msgid "Accelerator (text)"
msgstr "Accélérateur (texte)"

#: prefs.js:284
msgid "Behavior"
msgstr "Comportement"

#: prefs.js:289
msgid "Delay before display"
msgstr "Latence avant affichage"

#: prefs.js:290
msgid ""
"Milliseconds before the shortcut picker appears (press and hold is not "
"delayed)."
msgstr ""
"Millisecondes avant l’apparition du sélecteur du raccourci (l’appui long "
"n’est pas retardé)."

#: prefs.js:303
msgid "Auto-close (failsafe)"
msgstr "Auto-fermeture (failsafe)"

#: prefs.js:304
msgid "Milliseconds before automatic close."
msgstr "Millisecondes avant fermeture automatique."

#: prefs.js:317
msgid "Top bar icon"
msgstr "Icône dans la barre du haut"

#: prefs.js:318
msgid ""
"Show an icon with a quick on/off switch and a link to these settings. Bring "
"it back here after hiding it from its menu."
msgstr ""
"Affiche une icône avec un interrupteur rapide et un lien vers ces réglages. "
"À réactiver ici après l'avoir masquée depuis son menu."

#: prefs.js:337
msgid "Modified = saved automatically."
msgstr "Modifié = enregistré automatiquement."

#: prefs.js:349 prefs.js:451
msgid "Accentable characters"
msgstr "Caractères accentuables"

#: prefs.js:350
msgid "JSON table: base letter → list of accented variants."
msgstr "Table JSON : lettre de base → liste des variantes accentuées."

#: prefs.js:387
msgid "Save"
msgstr "Enregistrer"

#: prefs.js:391
msgid "Reset"
msgstr "Réinitialiser"

#: prefs.js:397
msgid "Edit in a larger window"
msgstr "Modifier dans une fenêtre plus grande"

#: prefs.js:406
msgid "Built-in default table active."
msgstr "Table intégrée par défaut active."

#: prefs.js:410
msgid ""
"Not saved: expected {\"e\": [\"é\", \"è\"], …} — an object of string lists."
msgstr ""
"Non enregistré : attendu {\"e\": [\"é\", \"è\"], …} — un objet de listes de "
"chaînes."

#: prefs.js:414
msgid "Saved."
msgstr "Enregistré."

#: prefs.js:444
msgid "Reset to the built-in table."
msgstr "Réinitialisé à la table intégrée."

#: prefs.js:518
msgid "Presets"
msgstr "Préréglages"

#: prefs.js:519
msgid ""
"Start from a ready-made table, keep your own, or share them as files. You "
"can still edit the table afterwards."
msgstr ""
"Partez d'une table toute faite, gardez les vôtres ou partagez-les sous forme "
"de fichiers. Vous pourrez toujours modifier la table ensuite."

#: prefs.js:524
msgid "Built-in (all languages)"
msgstr "Intégrée (toutes les langues)"

#: prefs.js:525
msgid "French"
msgstr "Français"

#: prefs.js:526
msgid "Spanish"
msgstr "Espagnol"

#: prefs.js:527
msgid "Portuguese"
msgstr "Portugais"

#: prefs.js:528
msgid "Italian"
msgstr "Italien"

#: prefs.js:529
msgid "German"
msgstr "Allemand"

#: prefs.js:530
msgid "Nordic (Danish, Norwegian, Swedish, Icelandic)"
msgstr "Nordique (danois, norvégien, suédois, islandais)"

#: prefs.js:531
msgid "Polish"
msgstr "Polonais"

#: prefs.js:532
msgid "Czech and Slovak"
msgstr "Tchèque et slovaque"

#: prefs.js:533
msgid "Turkish"
msgstr "Turc"

#: prefs.js:534
msgid "Romanian"
msgstr "Roumain"

#: prefs.js:535
msgid "Typography, currency and math symbols"
msgstr "Typographie, monnaies et symboles mathématiques"

#: prefs.js:544
msgid "Preset"
msgstr "Préréglage"

#: prefs.js:545
msgid "Replaces the table below."
msgstr "Remplace la table ci-dessous."

#: prefs.js:547
msgid "Load"
msgstr "Charger"

#: prefs.js:551
msgid "Delete this saved preset"
msgstr "Supprimer ce préréglage enregistré"

#: prefs.js:569
msgid "saved"
msgstr "enregistré"

#: prefs.js:598
msgid "Replace the current table?"
msgstr "Remplacer la table actuelle ?"

#: prefs.js:599
msgid ""
"Your edits are not saved as a preset. Export or save them first if you want "
"to keep them."
msgstr ""
"Vos modifications ne sont enregistrées dans aucun préréglage. Exportez-les "
"ou enregistrez-les d'abord si vous voulez les garder."

#: prefs.js:600
msgid "Cancel"
msgstr "Annuler"

#: prefs.js:600
msgid "Replace"
msgstr "Remplacer"

#: prefs.js:618
#, javascript-format
msgid "Preset “%s” loaded."
msgstr "Préréglage « %s » chargé."

#: prefs.js:636
#, javascript-format
msgid "Preset “%s” deleted."
msgstr "Préréglage « %s » supprimé."

#: prefs.js:643
msgid "Save the current table as a preset"
msgstr "Enregistrer la table actuelle comme préréglage"

#: prefs.js:652
msgid "Not saved: the table below is not valid yet."
msgstr "Non enregistré : la table ci-dessous n'est pas encore valide."

#: prefs.js:662
#, javascript-format
msgid "Preset “%s” updated."
msgstr "Préréglage « %s » mis à jour."

#: prefs.js:663
#, javascript-format
msgid "Preset “%s” saved."
msgstr "Préréglage « %s » enregistré."

#: prefs.js:669
msgid "Share"
msgstr "Partager"

#: prefs.js:670
msgid "A preset file is plain JSON: send it, or import one someone sent you."
msgstr ""
"Un fichier de préréglage est du JSON simple : envoyez-le, ou importez celui "
"qu'on vous a envoyé."

#: prefs.js:672
msgid "Import…"
msgstr "Importer…"

#: prefs.js:673
msgid "Export…"
msgstr "Exporter…"

#: prefs.js:689
msgid "Import a preset"
msgstr "Importer un préréglage"

#: prefs.js:704
msgid "Could not read the file."
msgstr "Impossible de lire le fichier."

#: prefs.js:709
msgid ""
"Not a preset: expected {\"name\": \"…\", \"accents\": {\"e\": [\"é\"], …}} "
"or a plain table."
msgstr ""
"Ce n'est pas un préréglage : attendu {\"name\": \"…\", \"accents\": {\"e\": "
"[\"é\"], …}} ou une table simple."

#: prefs.js:713
msgid "Imported preset"
msgstr "Préréglage importé"

#: prefs.js:726
msgid "Nothing exported: the table below is not valid yet."
msgstr "Rien d'exporté : la table ci-dessous n'est pas encore valide."

#: prefs.js:731
msgid "My accents"
msgstr "Mes accents"

#: prefs.js:733
msgid "Export the table"
msgstr "Exporter la table"

#: prefs.js:749
#, javascript-format
msgid "Exported to %s."
msgstr "Exporté vers %s."

#: prefs.js:751
msgid "Could not write the file."
msgstr "Impossible d'écrire le fichier."

#: prefs.js:765
msgid "Keyboards"
msgstr "Claviers"

#: prefs.js:766
msgid ""
"Layouts where press and hold and the shortcut are active (none checked = all "
"active)."
msgstr ""
"Dispositions où l’appui long et le raccourci sont actifs (aucune cochée = "
"toutes actives)."

#: prefs.js:789
msgid "No xkb layout detected"
msgstr "Aucun layout xkb détecté"

#: prefs.js:790
msgid "Accent Hold is active on all keyboards."
msgstr "Accent Hold est actif sur tous les claviers."
